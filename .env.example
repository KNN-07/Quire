QUIRE_DATA_DIR=.data
QUIRE_HOST=127.0.0.1
QUIRE_PORT=3001
QUIRE_PUBLIC_URL=http://localhost:5173
QUIRE_PROFILE=local
QUIRE_COMPILER_BACKEND=bwrap
# Transport ceiling includes multipart metadata; feature upload quotas are separate.
QUIRE_MAX_REQUEST_BYTES=67108864
# Optional when localhost IPv4 port 5173 belongs to another workspace:
# QUIRE_WEB_HOST=::1
# Local setup generates an owner-only key when unset. Production must supply one.
# QUIRE_SECRET_KEY=<64 lowercase hex characters>
# Local seed generates and displays a password once when unset.
# QUIRE_SEED_PASSWORD=<your local development password>
