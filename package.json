{
  "name": "quire",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4" },
  "workspaces": ["packages/*"],
  "trustedDependencies": ["bun", "esbuild"],
  "scripts": {
    "postinstall": "bun run assets",
    "assets": "bun scripts/python-assets.ts && bun scripts/spelling-assets.ts",
    "assets:python": "bun scripts/python-assets.ts",
    "assets:spelling": "bun scripts/spelling-assets.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch apps/server/src/main.ts",
    "dev:web": "bun run assets && node node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run assets && bun --bun vite build --config apps/web/vite.config.ts && bun build apps/server/src/main.ts --target=bun --outdir=dist/server && bun build apps/server/src/repository-main.ts --target=bun --outdir=dist/repository && bun build workers/compiler/main.ts --target=bun --outdir=dist/compiler && bun run build:installation",
    "build:installation": "bun build apps/server/src/installation-main.ts apps/server/src/installation-role.ts --target=bun --outdir=dist/installation && bun build scripts/ops/ssh.ts --target=bun --outfile=dist/installation/ssh.js",
    "installation:controller": "bun dist/installation/installation-main.js controller",
    "installation:status": "bun dist/installation/installation-main.js status",
    "installation:recover": "bun dist/installation/installation-main.js recover",
    "start:repository": "bun apps/server/src/repository-main.ts",
    "worker:compiler": "bun workers/compiler/main.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "seed": "bun scripts/seed.ts",
    "doctor": "bun scripts/ops/doctor.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "verify:matrix": "bun packages/runtime/src/verification.ts matrix",
    "ops:restore-drill": "bun packages/runtime/src/verification.ts restore",
    "test:scale": "bun test tests/integration/portable/assembly.test.ts tests/integration/portable/seed.test.ts tests/integration/portable/transfer-preflight.test.ts"
  },
  "dependencies": {
    "@node-saml/node-saml": "5.2.0",
    "@xmldom/xmldom": "0.9.12",
    "@quire/contracts": "workspace:*",
    "@quire/runtime": "workspace:*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.2",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "dictionary-vi": "3.0.0",
    "fflate": "0.8.3",
    "ky": "1.14.3",
    "ldapts": "9.2.0",
    "nspell": "2.1.5",
    "pdfjs-dist": "5.4.624",
    "pyodide": "314.0.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/nspell": "2.1.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "xml-crypto": "6.4.0"
  }
}
